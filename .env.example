# NIYANTRA Production Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to .env or configure these variables in your
# cloud hosting dashboard (Render / Railway / Fly.io / Vercel).

# Backend Environment Variables
ENVIRONMENT=production
DEBUG=false
APP_NAME=NIYANTRA Cloud Backend
APP_VERSION=2.0.0

# Database (PostgreSQL for Cloud / SQLite for Local Dev)
# Example PostgreSQL: postgresql://username:password@db.provider.com:5432/niyantra
DATABASE_URL=sqlite:///backend/niyantra.db

# Authentication & Security
JWT_SECRET_KEY=generate-a-strong-random-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated)
# Example: https://niyantra-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend Environment Variables (Vite)
# Point this to your deployed cloud backend or local IP for multi-device testing
# Example: https://niyantra-api.onrender.com/api or http://10.55.50.97:8000/api
VITE_API_URL=http://localhost:8000/api
